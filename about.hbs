<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Fleet: third-party licenses</title>
</head>
<body>
  <h1>Third-party licenses</h1>
  <p>Fleet includes the following third-party software.</p>
  {{#each licenses}}
  <h2 id="{{id}}">{{name}}</h2>
  <p>Used by:</p>
  <ul>
    {{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}
  </ul>
  <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
