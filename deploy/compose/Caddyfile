# TLS terminates here. `localhost` gets Caddy's internal CA; a real hostname gets ACME, or mount
# your certificates and add `tls /certs/fleet.crt /certs/fleet.key`.
{$FLEET_DOMAIN} {
	encode zstd gzip
	reverse_proxy fleet:8080 {
		# Config reloads would otherwise cut every agent and browser WebSocket (research 06 §9.2).
		stream_close_delay 5m
		flush_interval -1
	}
}

# Uploaded files (Maestro HTML reports, screenshots) are served from a second site, never the
# dashboard's (invariant I7). Use another registrable domain, and set FLEET_USERCONTENT_DOMAIN in
# .env. Fleet routes by Host: it serves only signed /u/… links here, sandboxed, with no cookies.
{$FLEET_USERCONTENT_DOMAIN} {
	encode zstd gzip
	reverse_proxy fleet:8080
}
