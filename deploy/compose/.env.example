# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
FLEET_DOMAIN=localhost
# A different registrable domain from FLEET_DOMAIN in production (uploaded files are served here).
FLEET_USERCONTENT_DOMAIN=usercontent.localhost
# FLEET_IMAGE=ghcr.io/moyaver/fleet:0.1.0-alpha.4
# Garage's RPC secret, the S3 key pair and Garage's default key are secret files, not values
# here: see README.md ("Garage secrets").
