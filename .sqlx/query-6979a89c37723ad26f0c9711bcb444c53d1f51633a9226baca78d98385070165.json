  "query": "SELECT f.id, f.started,\n                (s.lifecycle = 'closed' OR r.state = 'ended') AS \"run_ended!\"\n           FROM flow_executions f\n           JOIN suite_executions s ON s.id = f.suite_execution_id\n           JOIN agent_runs r ON r.id = f.agent_run_id\n          WHERE f.id = ANY($1)",
