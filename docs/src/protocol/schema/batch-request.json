{
  "$defs": {
    "AdbState": {
      "description": "adb's view of a device.",
      "oneOf": [
        {
          "const": "device",
          "description": "Online and usable.",
          "type": "string"
        },
        {
          "const": "offline",
          "description": "Connected but not responding.",
          "type": "string"
        },
        {
          "const": "unauthorized",
          "description": "Needs authorization on the device.",
          "type": "string"
        },
        {
          "const": "absent",
          "description": "Gone from adb's list.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Another state adb reported.",
          "type": "string"
        }
      ]
    },
    "AgentInfo": {
      "description": "The agent build.",
      "properties": {
        "arch": {
          "description": "`std::env::consts::ARCH`.",
          "type": "string"
        },
        "os": {
          "description": "`std::env::consts::OS`.",
          "type": "string"
        },
        "version": {
          "description": "Agent version.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "os",
        "arch"
      ],
      "type": "object"
    },
    "CatalogFlow": {
      "description": "One flow file of the workspace, as its header describes it.",
      "properties": {
        "name": {
          "description": "The `name:` of its header, when it has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The flow's path, relative to the repository root, as the flow's runs name it.",
          "type": "string"
        },
        "tags": {
          "description": "The `tags:` of its header.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "CiContext": {
      "description": "CI identity as claimed by the agent (research 06 §1).",
      "properties": {
        "git_ref": {
          "description": "Git ref.",
          "type": [
            "string",
            "null"
          ]
        },
        "job_key": {
          "description": "Stable job identity within the attempt (PLAN §6.7).",
          "type": "string"
        },
        "job_name": {
          "description": "Job display name.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/CiProvider",
          "description": "Which CI."
        },
        "repository": {
          "description": "`owner/name`.",
          "type": [
            "string",
            "null"
          ]
        },
        "run_attempt": {
          "description": "Re-run attempt, from 1.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "run_id": {
          "description": "Workflow run ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "runner": {
          "description": "Runner name.",
          "type": [
            "string",
            "null"
          ]
        },
        "sha": {
          "description": "Commit SHA.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "job_key"
      ],
      "type": "object"
    },
    "CiProvider": {
      "description": "CI provider.",
      "oneOf": [
        {
          "const": "github_actions",
          "description": "GitHub Actions.",
          "type": "string"
        },
        {
          "const": "generic",
          "description": "Anything else, described by `FLEET_*` variables.",
          "type": "string"
        }
      ]
    },
    "ClockSample": {
      "description": "When something happened: the agent's wall clock and its monotonic clock since process start.\n\nDurations come from `mono_ms` differences, never from wall-clock subtraction (research 05 §5.6).",
      "properties": {
        "mono_ms": {
          "description": "Milliseconds since the agent process started, monotonic.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "wall": {
          "description": "Agent wall clock, UTC.",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "wall",
        "mono_ms"
      ],
      "type": "object"
    },
    "DeviceSample": {
      "description": "One device's sample: what adb and the guest reported about a device session at one time.\n`None` means that reading was not observed; a device that could not be reached has `None`\nreadings, never zeros.",
      "properties": {
        "adb_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdbState"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "adb's state for the device at sampling time, from the device list adb pushed. `Absent`\nmeans the list did not contain it."
        },
        "api_level": {
          "default": null,
          "description": "The device's API level (`ro.build.version.sdk`), once read. `None` until then.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "at": {
          "$ref": "#/$defs/ClockSample",
          "description": "When the probe was started."
        },
        "avd_name": {
          "default": null,
          "description": "The emulator's AVD name, from its command line (`-avd`). `None` for a physical device.",
          "type": [
            "string",
            "null"
          ]
        },
        "boot_completed": {
          "default": null,
          "description": "Whether `sys.boot_completed` was `1` when the probe ran. `None`: the probe did not answer.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "device_session_id": {
          "description": "The device session the sample belongs to (its `shard.assigned` event names it).",
          "format": "uuid",
          "type": "string"
        },
        "emu_cpu_pct": {
          "default": null,
          "description": "The emulator process's CPU use since the previous sample, percent of one core. `None` for\na physical device, when no emulator process maps to the serial, or when it was unreadable.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "emu_rss_bytes": {
          "default": null,
          "description": "The emulator process's resident memory, bytes. `None` as for `emu_cpu_pct`.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "foreground_activity": {
          "default": null,
          "description": "The component of the resumed activity. Set only on the sample taken after a flow failed on\nthis device (PLAN §6.5: current activity only on failure); `None` otherwise.",
          "type": [
            "string",
            "null"
          ]
        },
        "guest_cpu_pct": {
          "default": null,
          "description": "The guest's CPU use since the previous probe of this device, percent of all its cores.\n`None` for the first probe and when the probe did not answer.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "guest_mem_available_bytes": {
          "default": null,
          "description": "The guest's `MemAvailable`, bytes. `None` when the probe did not answer.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "model": {
          "description": "The device's model (`ro.product.model`), once read; carried on every sample after that.\nAbsent from older agents (issue #85).",
          "type": [
            "string",
            "null"
          ]
        },
        "os_version": {
          "description": "The device's OS version (`ro.build.version.release`), once read, as `model`. Absent from\nolder agents (issue #85).",
          "type": [
            "string",
            "null"
          ]
        },
        "shard": {
          "description": "The shard the device was assigned to: the planner's shard for a plan run (`plan.assigned`,\nas the plan numbers it), otherwise the `shard_number` its `shard.assigned` event names\n(1-based). Absent from older agents.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unavailable": {
          "$ref": "#/$defs/DeviceUnavailable",
          "description": "Why each reading above is unknown, for every reading that is `None` (PLAN §6.5: availability\nwith a reason when unknown). Empty from older agents."
        }
      },
      "required": [
        "at",
        "device_session_id"
      ],
      "type": "object"
    },
    "DeviceUnavailable": {
      "description": "The reason each device reading is unknown. Each field is the reason for the reading of the\nsame name in [`DeviceSample`]; a reading that is set has `None` here.",
      "properties": {
        "adb_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `adb_state` is unknown."
        },
        "api_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `api_level` is unknown."
        },
        "avd_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `avd_name` is unknown."
        },
        "boot_completed": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `boot_completed` is unknown."
        },
        "emu_cpu_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `emu_cpu_pct` is unknown."
        },
        "emu_rss_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `emu_rss_bytes` is unknown."
        },
        "foreground_activity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `foreground_activity` is unknown."
        },
        "guest_cpu_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `guest_cpu_pct` is unknown."
        },
        "guest_mem_available_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `guest_mem_available_bytes` is unknown."
        }
      },
      "type": "object"
    },
    "EventEnvelope": {
      "description": "One journal event as it travels and is stored.",
      "properties": {
        "at": {
          "$ref": "#/$defs/ClockSample",
          "description": "When it happened (not when it was sent)."
        },
        "data": {
          "description": "The type-specific payload, kept as JSON so unknown types survive."
        },
        "seq": {
          "description": "Sequence number within the agent run, from 1. Gap-free except for a hole the agent\nreports with a `journal.gap` sequenced at the hole's last `seq`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "src": {
          "$ref": "#/$defs/Provenance",
          "description": "Where the evidence came from."
        },
        "subject": {
          "$ref": "#/$defs/Subject",
          "description": "The entities it's about."
        },
        "type": {
          "description": "Event type, for example `flow.ended`.",
          "type": "string"
        },
        "v": {
          "description": "Version of this type's payload.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "type",
        "v",
        "at",
        "src",
        "data"
      ],
      "type": "object"
    },
    "FlowCatalog": {
      "description": "The flows a workspace holds, as the agent found them (issue #85). Bounded by the agent: at most\n[`MAX_CATALOG_FLOWS`] entries, and `truncated` says more were found and left out.",
      "properties": {
        "flows": {
          "default": [],
          "description": "The flows, sorted by path.",
          "items": {
            "$ref": "#/$defs/CatalogFlow"
          },
          "type": "array"
        },
        "truncated": {
          "description": "More flows than `flows` lists were found.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Hello": {
      "description": "The handshake payload.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentInfo",
          "description": "The agent build."
        },
        "agent_run_id": {
          "description": "Generated once per agent process (UUIDv7); owns the `seq` space.",
          "format": "uuid",
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/FlowCatalog",
          "description": "The flows the run's workspace holds, as the agent found them before Maestro ran (issue\n#85). Empty from older agents and when there is no workspace to read; the server then learns\nno flow it hasn't seen run."
        },
        "ci": {
          "$ref": "#/$defs/CiContext",
          "description": "CI identity as the agent sees it; the server prefers OIDC claims."
        },
        "clock": {
          "$ref": "#/$defs/ClockSample",
          "description": "Agent clock at send."
        },
        "origin": {
          "$ref": "#/$defs/RunOrigin",
          "description": "Where the run's evidence came from. Absent from live agents, which send nothing here."
        },
        "previous_agent_run_id": {
          "description": "The run this one replaces after an agent restart in the same job.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolRange",
          "description": "Protocol versions the agent speaks."
        },
        "resume": {
          "$ref": "#/$defs/ResumeState",
          "description": "What the agent still holds."
        },
        "started_at": {
          "description": "When the run started, as the agent recorded it. A published run takes its date (`run_day`)\nfrom this, not from the day it is published; a live run leaves it out and starts now.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "protocol",
        "agent",
        "agent_run_id",
        "ci",
        "resume",
        "clock"
      ],
      "type": "object"
    },
    "ProtocolRange": {
      "description": "A closed range of protocol versions.",
      "properties": {
        "max": {
          "description": "Newest supported.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "min": {
          "description": "Oldest supported.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "Provenance": {
      "description": "The provenance of one event (invariant I4).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/SourceKind",
          "description": "Where the evidence came from."
        },
        "locator": {
          "description": "Where in the source: a line number or a file path relative to the run directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "parser": {
          "description": "Our parser and the Maestro version profile it used, for example `maestro-log@2.12`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ResumeState": {
      "description": "What the agent can resend.",
      "properties": {
        "next_seq": {
          "description": "The next `seq` the agent will assign.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "oldest_unacked_seq": {
          "description": "The oldest event it still holds unacked.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "next_seq"
      ],
      "type": "object"
    },
    "RunOrigin": {
      "description": "Where a run's evidence came from (issue #83). A live run is observed as it happens; a published\nrun is a finished run the agent sent after the fact (`fleet-agent publish`), so the server shows\nit as imported, never as live.",
      "oneOf": [
        {
          "const": "live",
          "description": "Observed while it ran.",
          "type": "string"
        },
        {
          "const": "published",
          "description": "Sent after the fact by `fleet-agent publish`: an offline bundle or a saved output.",
          "type": "string"
        }
      ]
    },
    "Sample": {
      "description": "One metric sample. `None` means unavailable, never zero (research 05 §5.4).\n\nEvery reading carries its unit in its field name (`_pct` percent, `_bytes` bytes, `_cores`\ncores; the load average is a plain number), and its scope in its prefix: `host_` is the\nmachine, `maestro_` the Maestro process of the run and `agent_` the agent itself (its\nsupervisor and observer). A reading that is `None` has its reason in `unavailable`.",
      "properties": {
        "agent_cpu_pct": {
          "description": "The agent itself (supervisor + observer): CPU percent of one core since the last sample\n(invariant I10).",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "agent_rss_bytes": {
          "description": "The agent itself (supervisor + observer): current resident memory of both, summed, bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "at": {
          "$ref": "#/$defs/ClockSample",
          "description": "When it was taken."
        },
        "host_cpu_cores": {
          "default": null,
          "description": "Host physical CPU cores. Absent from older agents.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "host_cpu_pct": {
          "description": "Host CPU use across all cores, percent.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "host_load_1m": {
          "default": null,
          "description": "Host load average over one minute (runnable tasks, averaged). Absent from older agents.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "host_mem_total_bytes": {
          "description": "Host memory total, bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "host_mem_used_bytes": {
          "description": "Host memory in use, bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "host_psi_cpu_pct": {
          "default": null,
          "description": "Linux pressure stall information: percent of the last 10 seconds in which some task\nwaited for CPU. `None` where the kernel has no PSI (macOS, Windows). Absent from older\nagents.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "host_psi_io_pct": {
          "default": null,
          "description": "Linux pressure stall information: percent of the last 10 seconds in which some task\nwaited for I/O. Absent from older agents.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "host_psi_memory_pct": {
          "default": null,
          "description": "Linux pressure stall information: percent of the last 10 seconds in which some task\nwaited for memory. Absent from older agents.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "host_swap_total_bytes": {
          "default": null,
          "description": "Host swap configured, bytes. Absent from older agents.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "host_swap_used_bytes": {
          "default": null,
          "description": "Host swap in use, bytes. Absent from older agents.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maestro_cpu_pct": {
          "description": "Maestro's JVM: CPU percent of one core.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "maestro_rss_bytes": {
          "description": "Maestro's JVM: resident memory, bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unavailable": {
          "$ref": "#/$defs/SampleUnavailable",
          "description": "Why each reading above is unknown, for every reading that is `None` (PLAN §6.5). Empty from\nolder agents."
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "SampleUnavailable": {
      "description": "The reason each reading of a [`Sample`] is unknown. Each field is the reason for the reading of\nthe same name; a reading that is set has `None` here (PLAN §6.5).",
      "properties": {
        "agent_cpu_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `agent_cpu_pct` is unknown."
        },
        "agent_rss_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `agent_rss_bytes` is unknown."
        },
        "host_cpu_cores": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_cpu_cores` is unknown."
        },
        "host_cpu_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_cpu_pct` is unknown."
        },
        "host_load_1m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_load_1m` is unknown."
        },
        "host_mem_total_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_mem_total_bytes` is unknown."
        },
        "host_mem_used_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_mem_used_bytes` is unknown."
        },
        "host_psi_cpu_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_psi_cpu_pct` is unknown."
        },
        "host_psi_io_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_psi_io_pct` is unknown."
        },
        "host_psi_memory_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_psi_memory_pct` is unknown."
        },
        "host_swap_total_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_swap_total_bytes` is unknown."
        },
        "host_swap_used_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `host_swap_used_bytes` is unknown."
        },
        "maestro_cpu_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `maestro_cpu_pct` is unknown."
        },
        "maestro_rss_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unavailable"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why `maestro_rss_bytes` is unknown."
        }
      },
      "type": "object"
    },
    "SourceKind": {
      "description": "Where a piece of evidence came from. The claim lattice ranks these (fleet-core).",
      "oneOf": [
        {
          "const": "declared",
          "description": "Supplied up front: CLI arguments, a manifest.",
          "type": "string"
        },
        {
          "const": "agent_observed",
          "description": "The agent's own direct observation: adb, signals, spawn, files existing.",
          "type": "string"
        },
        {
          "const": "process_exit",
          "description": "Maestro's exit status.",
          "type": "string"
        },
        {
          "const": "live_console",
          "description": "Parsed Maestro stdout/stderr.",
          "type": "string"
        },
        {
          "const": "debug_log",
          "description": "Parsed `maestro.log`.",
          "type": "string"
        },
        {
          "const": "artifact_file",
          "description": "Structured per-flow artifacts such as `commands.json`.",
          "type": "string"
        },
        {
          "const": "junit_final",
          "description": "Maestro's final JUnit report.",
          "type": "string"
        },
        {
          "const": "server_inferred",
          "description": "Inferred by the server (for example after an agent disappeared). Agents may not send it.",
          "type": "string"
        },
        {
          "const": "unrecognized",
          "description": "A kind this build doesn't know. Never ranks as evidence of success.",
          "type": "string"
        }
      ]
    },
    "StepRef": {
      "description": "A step inside a flow execution.",
      "properties": {
        "index": {
          "description": "0-based position in the flow's steps as they were observed (nested steps included).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "index"
      ],
      "type": "object"
    },
    "Subject": {
      "description": "Which execution entities an event is about. All IDs are agent-generated UUIDv7.",
      "properties": {
        "device_session_id": {
          "description": "One device for the life of this agent run.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "flow_execution_id": {
          "description": "One execution of one flow.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "shard_id": {
          "description": "One shard of that invocation.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "One step of that flow execution."
        },
        "suite_execution_id": {
          "description": "One Maestro invocation.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Telemetry": {
      "description": "A batch of metric samples.",
      "properties": {
        "devices": {
          "description": "Device samples taken since the previous batch, one per device per sampling interval\n(PLAN §6.5). Absent from older agents.",
          "items": {
            "$ref": "#/$defs/DeviceSample"
          },
          "type": "array"
        },
        "dropped_since_last": {
          "default": 0,
          "description": "Samples dropped since the previous batch (the ring was full).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "samples": {
          "description": "The samples.",
          "items": {
            "$ref": "#/$defs/Sample"
          },
          "type": "array"
        },
        "tseq_from": {
          "description": "First sample's `tseq`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tseq_to": {
          "description": "Last sample's `tseq`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tseq_from",
        "tseq_to",
        "samples"
      ],
      "type": "object"
    },
    "Unavailable": {
      "description": "Why a device, host or process reading is unknown (PLAN §6.5). A reading that is set has no\nreason.",
      "oneOf": [
        {
          "const": "not_an_emulator",
          "description": "The serial is not an emulator's (`emulator-<console port>`), so no emulator process is read.",
          "type": "string"
        },
        {
          "const": "no_emulator_process",
          "description": "An emulator serial that no `qemu-system-*` process maps to (it exited, or the process table\ncould not be read), or a device session the agent no longer drives.",
          "type": "string"
        },
        {
          "const": "no_avd_name",
          "description": "The emulator's command line names no AVD (`-avd` is optional).",
          "type": "string"
        },
        {
          "const": "probe_failed",
          "description": "adb did not answer the read, or answered without it (an error, a timeout or a malformed\nreply).",
          "type": "string"
        },
        {
          "const": "throttled",
          "description": "The host is under pressure, so the guest's CPU and memory are not read (PLAN §6.5).",
          "type": "string"
        },
        {
          "const": "no_baseline",
          "description": "The first probe of a device only sets its CPU baseline; so does one after the guest's\ncounters went backwards.",
          "type": "string"
        },
        {
          "const": "no_adb_list",
          "description": "adb's device list has not arrived yet.",
          "type": "string"
        },
        {
          "const": "not_sampled",
          "description": "This sample does not take the reading: a probe sample carries no activity, and the sample\nof a failed flow's activity carries no probe.",
          "type": "string"
        },
        {
          "const": "no_system_info",
          "description": "The platform's system information could not be read, so no host or process reading that\ncomes from it was taken.",
          "type": "string"
        },
        {
          "const": "no_psi",
          "description": "The kernel has no pressure stall information (PSI) for the resource: macOS and Windows.",
          "type": "string"
        },
        {
          "const": "no_process",
          "description": "The process is not known to this run yet (Maestro has not started), or it has exited.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A reason this build doesn't know.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The HTTPS batch fallback (`POST /api/v1/agent/batch`) for networks that block web sockets:\none `hello`, then what a socket would have carried. Each request is a connection of its own.",
  "properties": {
    "events": {
      "default": [],
      "description": "Journal events, contiguous in `seq`.",
      "items": {
        "$ref": "#/$defs/EventEnvelope"
      },
      "type": "array"
    },
    "hello": {
      "$ref": "#/$defs/Hello",
      "description": "Opens or resumes the run, exactly as on the socket."
    },
    "telemetry": {
      "default": [],
      "description": "Metric batches.",
      "items": {
        "$ref": "#/$defs/Telemetry"
      },
      "type": "array"
    }
  },
  "required": [
    "hello"
  ],
  "title": "BatchRequest",
  "type": "object"
}
